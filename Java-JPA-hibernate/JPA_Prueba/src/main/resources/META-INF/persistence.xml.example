<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="miUnidad">
        <class>org.example.logica.Alumno</class>
        <class>org.example.logica.Carrera</class>
        <class>org.example.logica.Materia</class>
        <properties>
            <!-- Conexión: cambia estos valores por los de tu base de datos -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/NOMBRE_BD"/>
            <property name="jakarta.persistence.jdbc.user" value="TU_USUARIO"/>
            <property name="jakarta.persistence.jdbc.password" value="TU_PASSWORD"/>

            <!-- create: borra y recrea las tablas en cada ejecución (útil para practicar).
                 update: conserva los datos y solo agrega lo nuevo. -->
            <property name="hibernate.hbm2ddl.auto" value="create"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>